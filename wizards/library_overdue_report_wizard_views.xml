<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_library_overdue_report_wizard_form" model="ir.ui.view">
        <field name="name">library.overdue.report.wizard.form</field>
        <field name="model">library.overdue.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Overdue Loans Report">
                <group>
                    <field name="date_as_of"/>
                    <field name="borrower_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print" string="Print PDF" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_library_overdue_report_wizard" model="ir.actions.act_window">
        <field name="name">Overdue Loans Report</field>
        <field name="res_model">library.overdue.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
