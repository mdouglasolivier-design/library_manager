<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_library_ebook_notification"
                model="mail.template">
            <field name="name">Library eBook member notification</field>
            <field name="model_id" ref="model_library_ebook_notification"/>
            <field name="subject">Library eBook update</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.partner_id.name or 'reader'"/>.</p>
                    <p t-if="object.notification_type == 'request_submitted'">
                        Your request to borrow
                        <strong t-out="object.ebook_id.name or 'an eBook'"/>
                        has been received.
                    </p>
                    <p t-elif="object.notification_type == 'request_approved'">
                        Your request for
                        <strong t-out="object.ebook_id.name or 'an eBook'"/>
                        has been approved. The title is available in My Library.
                    </p>
                    <p t-elif="object.notification_type == 'request_rejected'">
                        Your request for
                        <strong t-out="object.ebook_id.name or 'an eBook'"/>
                        was not approved. Contact the library if you need more
                        information.
                    </p>
                    <p t-elif="object.notification_type == 'reservation_submitted'">
                        Your reservation for
                        <strong t-out="object.ebook_id.name or 'an eBook'"/>
                        has been received.
                    </p>
                    <p t-elif="object.notification_type == 'reservation_fulfilled'">
                        Your reservation for
                        <strong t-out="object.ebook_id.name or 'an eBook'"/>
                        has been fulfilled. Check My Library for its loan dates.
                    </p>
                    <p>
                        Sign in to your library account and open
                        <strong>My Library → Notifications</strong> for details.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="mail_template_library_ebook_overdue_reminder"
                model="mail.template">
            <field name="name">Library eBook overdue reminder</field>
            <field name="model_id" ref="model_library_ebook_loan"/>
            <field name="subject">Your library eBook loan is overdue</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.borrower_id.name or 'reader'"/>.</p>
                    <p>
                        Your loan of
                        <strong t-out="object.ebook_id.name or 'an eBook'"/>
                        was due on <strong t-out="object.due_date"/>.
                    </p>
                    <p>
                        Please sign in to your library account and open My Library
                        to review this loan. This reminder will be sent once per
                        day while the loan remains overdue.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
