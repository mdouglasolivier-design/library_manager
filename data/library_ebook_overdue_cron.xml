<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_library_ebook_overdue_reminders" model="ir.cron">
            <field name="name">Library: eBook overdue reminders</field>
            <field name="model_id" ref="model_library_ebook_loan"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
