<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_library_payment_receipt"
                model="mail.template">
            <field name="name">Library payment receipt</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="subject">Your library payment receipt {{ object.reference }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.partner_id.name or 'reader'"/>.</p>
                    <p>
                        Thank you. Your payment of
                        <strong t-out="format_amount(object.amount, object.currency_id)"/>
                        <t t-if="object.library_receipt_item">
                            for <strong t-out="object.library_receipt_item"/>
                        </t>
                        was verified.
                    </p>
                    <p>
                        Payment reference:
                        <strong t-out="object.reference"/>
                    </p>
                    <p>Your PDF receipt is attached to this email.</p>
                    <p>
                        You can also download it any time from
                        <strong>My Library &#8594; Payments</strong>.
                    </p>
                </div>
            </field>
            <field name="report_template_ids"
                   eval="[(4, ref('library_manager.action_library_payment_receipt'))]"/>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
