<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_library_payment_receipt" model="ir.actions.report">
        <field name="name">Library Payment Receipt</field>
        <field name="model">payment.transaction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_manager.report_library_payment_receipt</field>
        <field name="report_file">library_manager.report_library_payment_receipt</field>
        <field name="binding_model_id" ref="payment.model_payment_transaction"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_library_payment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tx">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Odoo Library Payment Receipt</h2>
                        <p><strong>Reference:</strong> <span t-esc="tx.reference"/></p>
                        <p><strong>Member:</strong> <span t-esc="tx.partner_id.name"/></p>
                        <p><strong>Provider:</strong> <span t-esc="tx.provider_id.name"/></p>
                        <p><strong>Amount:</strong>
                            <span t-field="tx.amount"
                                  t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"/>
                        </p>
                        <p><strong>Status:</strong> Paid and verified</p>
                        <p><strong>Date:</strong> <span t-field="tx.last_state_change"/></p>
                        <p>This receipt confirms the payment provider reported this transaction as successful.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
