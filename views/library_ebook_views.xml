<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_ebook_list" model="ir.ui.view">
        <field name="name">library.ebook.list</field>
        <field name="model">library.ebook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author"/>
                <field name="category_id"/>
                <field name="isbn"/>
                <field name="publication_date"/>
                <field name="loan_count"/>
                <field name="file_available"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="view_library_ebook_form" model="ir.ui.view">
        <field name="name">library.ebook.form</field>
        <field name="model">library.ebook</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="loan_count" widget="statinfo"
                                   string="Loans"/>
                        </button>
                    </div>
                    <notebook>
                        <page string="Upload eBook and Preview Cover">
                            <field name="asset_ids">
                                <list>
                                    <field name="filename"/>
                                    <field name="file_format"/>
                                    <field name="file_size" readonly="1"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="filename"/>
                                            <field name="file_format"/>
                                            <field name="file_data"
                                                   filename="filename"/>
                                            <field name="cover_preview"
                                                   widget="image" readonly="1"
                                                   options="{'size': [0, 240]}"/>
                                            <field name="file_size" readonly="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <div class="text-muted">
                                Upload a valid PDF or EPUB to preview its
                                extracted cover. You can replace the cover
                                manually under Book Details.
                            </div>
                        </page>
                        <page string="Book Details">
                            <div class="oe_title">
                                <label for="name"/>
                                <h1><field name="name"
                                           placeholder="eBook title"/></h1>
                            </div>
                            <group>
                                <group>
                                    <field name="author"/>
                                    <field name="publisher"/>
                                    <field name="isbn"/>
                                    <field name="publication_date"/>
                                    <field name="category_id"/>
                                    <field name="language"/>
                                    <field name="file_format"/>
                                </group>
                                <group>
                                    <field name="active"/>
                                    <field name="website_published"/>
                                    <field name="file_available" readonly="1"/>
                                </group>
                            </group>
                            <field name="cover_image" widget="image"
                                   class="oe_avatar"
                                   options="{'size': [0, 360]}"/>
                            <field name="description"/>
                        </page>
                        <page string="Loan History">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="borrower_id"/>
                                    <field name="borrow_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_ebook_search" model="ir.ui.view">
        <field name="name">library.ebook.search</field>
        <field name="model">library.ebook</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="category_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="website_published" string="Published on Website"
                        domain="[('website_published', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_library_ebook" model="ir.actions.act_window">
        <field name="name">Ebooks</field>
        <field name="res_model">library.ebook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first ebook</p>
        </field>
    </record>
</odoo>
