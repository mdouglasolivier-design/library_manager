<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_ebook_access_list" model="ir.ui.view">
        <field name="name">library.ebook.access.list</field>
        <field name="model">library.ebook.access</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="ebook_id"/>
                <field name="borrower_id"/>
                <field name="loan_id"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="action_library_ebook_access" model="ir.actions.act_window">
        <field name="name">Ebook Access</field>
        <field name="res_model">library.ebook.access</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
