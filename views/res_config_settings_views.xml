<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_library" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.library</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="library_manager" string="Library"
                     groups="base.group_system">
                    <block title="Digital eBook lending">
                        <setting string="Require librarian approval"
                                 help="When enabled, a librarian must approve each borrowing request.">
                            <field name="library_ebook_approval_required"/>
                        </setting>
                        <setting string="Loan duration"
                                 help="The number of days in each new eBook loan.">
                            <field name="library_ebook_loan_duration_days"/>
                        </setting>
                        <setting string="Maximum active loans per member"
                                 help="Set to 0 for no limit.">
                            <field name="library_ebook_max_active_loans"/>
                        </setting>
                        <setting string="Maximum concurrent loans per eBook"
                                 help="Set to 0 for no limit. When the limit is reached, members can reserve the eBook.">
                            <field name="library_ebook_max_concurrent_loans"/>
                        </setting>
                    </block>
                    <block title="Library payment checkout">
                        <setting string="eBook borrowing price"
                                 help="The configured price used for new eBook payment transactions.">
                            <field name="library_ebook_borrowing_price"/>
                        </setting>
                        <setting string="Physical book borrowing price"
                                 help="The configured price used for new physical book payment transactions.">
                            <field name="library_physical_borrowing_price"/>
                        </setting>
                        <setting string="Payment currency"
                                 help="Use an active ISO currency code supported by the configured provider.">
                            <field name="library_payment_currency"/>
                        </setting>
                    </block>
                    <block title="Online payments">
                        <p class="text-muted">
                            All payments go through Flutterwave (cards and mobile money). Enter the Flutterwave keys under Payment Providers. Members are never asked to type card numbers or PINs on this website, and nobody uploads proof of payment: receipts are created automatically when Flutterwave confirms a payment.
                        </p>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
