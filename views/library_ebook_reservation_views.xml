<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_ebook_reservation_list" model="ir.ui.view">
        <field name="name">library.ebook.reservation.list</field>
        <field name="model">library.ebook.reservation</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'fulfilled'">
                <field name="reservation_date"/>
                <field name="ebook_id"/>
                <field name="borrower_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'fulfilled'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="loan_id"/>
            </list>
        </field>
    </record>

    <record id="view_library_ebook_reservation_form" model="ir.ui.view">
        <field name="name">library.ebook.reservation.form</field>
        <field name="model">library.ebook.reservation</field>
        <field name="arch" type="xml">
            <form create="1" delete="0">
                <header>
                    <button name="action_mark_fulfilled" string="Mark Fulfilled"
                            type="object" class="btn-primary"
                            groups="library_manager.group_library_librarian,base.group_system"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancel Reservation"
                            type="object"
                            groups="library_manager.group_library_librarian,base.group_system"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="pending,fulfilled,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ebook_id"/>
                            <field name="borrower_id"/>
                            <field name="loan_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reservation_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Optional notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_ebook_reservation_search" model="ir.ui.view">
        <field name="name">library.ebook.reservation.search</field>
        <field name="model">library.ebook.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="ebook_id"/>
                <field name="borrower_id"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="fulfilled" string="Fulfilled"
                        domain="[('state', '=', 'fulfilled')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_ebook" string="Ebook"
                            context="{'group_by': 'ebook_id'}"/>
                    <filter name="group_borrower" string="Reader"
                            context="{'group_by': 'borrower_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_ebook_reservation" model="ir.actions.act_window">
        <field name="name">Ebook Reservations</field>
        <field name="res_model">library.ebook.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
