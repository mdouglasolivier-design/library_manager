<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_library.book.list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'lost'">
                <field name="name"/>
                <field name="author"/>
                <field name="category"/>
                <field name="isbn"/>
                <field name="borrower_id"/>
                <field name="due_date"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'borrowed'"
                       decoration-danger="state == 'lost'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_borrow" string="Lend Book" type="object"
                            class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_return" string="Return Book" type="object"
                            class="btn-primary" invisible="state != 'borrowed'"/>
                    <button name="action_mark_lost" string="Mark as Lost" type="object"
                            invisible="state == 'lost'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,borrowed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Book title"/></h1>
                    </div>
                    <group>
                        <group string="Book Details">
                            <field name="author"/>
                            <field name="isbn"/>
                            <field name="category"/>
                            <field name="pages"/>
                            <field name="published_date"/>
                        </group>
                        <group string="Lending">
                            <field name="borrower_id" readonly="state != 'available'"/>
                            <field name="borrow_date" readonly="1"/>
                            <field name="due_date" readonly="1"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="borrower_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="borrowed" string="Borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_author" string="Author" context="{'group_by': 'author'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first book</p>
        </field>
    </record>

</odoo>
