<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_ebook_audit_list" model="ir.ui.view">
        <field name="name">library.ebook.audit.list</field>
        <field name="model">library.ebook.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_date"/>
                <field name="actor_id"/>
                <field name="partner_id"/>
                <field name="event_type"/>
                <field name="ebook_id"/>
                <field name="loan_id"/>
                <field name="request_id"/>
                <field name="reservation_id"/>
                <field name="details"/>
            </list>
        </field>
    </record>

    <record id="action_library_ebook_audit" model="ir.actions.act_window">
        <field name="name">eBook Audit Trail</field>
        <field name="res_model">library.ebook.audit</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_library_ebook_audit_list"/>
        <field name="domain">[]</field>
    </record>
</odoo>
