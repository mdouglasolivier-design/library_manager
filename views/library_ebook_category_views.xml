<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_ebook_category_list" model="ir.ui.view">
        <field name="name">library.ebook.category.list</field>
        <field name="model">library.ebook.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="ebook_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_library_ebook_category_form" model="ir.ui.view">
        <field name="name">library.ebook.category.form</field>
        <field name="model">library.ebook.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="eBooks">
                        <field name="ebook_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="author"/>
                                <field name="website_published"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_ebook_category" model="ir.actions.act_window">
        <field name="name">eBook Categories</field>
        <field name="res_model">library.ebook.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
