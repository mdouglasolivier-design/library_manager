<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_ebook_request_list" model="ir.ui.view">
        <field name="name">library.ebook.request.list</field>
        <field name="model">library.ebook.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('rejected', 'cancelled')"
                  decoration-success="state == 'approved'">
                <field name="request_date"/>
                <field name="ebook_id"/>
                <field name="borrower_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="loan_id"/>
                <field name="decision_date"/>
            </list>
        </field>
    </record>

    <record id="view_library_ebook_request_form" model="ir.ui.view">
        <field name="name">library.ebook.request.form</field>
        <field name="model">library.ebook.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve"
                            type="object" class="btn-primary"
                            groups="library_manager.group_library_librarian,base.group_system"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            groups="library_manager.group_library_librarian,base.group_system"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancel Request"
                            type="object"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="pending,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ebook_id"/>
                            <field name="borrower_id"/>
                            <field name="loan_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="decision_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_ebook_request_search" model="ir.ui.view">
        <field name="name">library.ebook.request.search</field>
        <field name="model">library.ebook.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="ebook_id"/>
                <field name="borrower_id"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <record id="action_library_ebook_request" model="ir.actions.act_window">
        <field name="name">eBook Requests</field>
        <field name="res_model">library.ebook.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
