<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_library_payment_ebook_requests" model="ir.actions.act_window">
        <field name="name">eBook Payment Requests</field>
        <field name="res_model">library.ebook.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_status', '=', 'pending')]</field>
    </record>
    <record id="action_library_payment_physical_requests" model="ir.actions.act_window">
        <field name="name">Physical Book Payment Requests</field>
        <field name="res_model">library.book.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_status', '=', 'pending')]</field>
    </record>
    <record id="action_library_payment_reservations" model="ir.actions.act_window">
        <field name="name">eBook Reservation Payments</field>
        <field name="res_model">library.ebook.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_status', '=', 'pending')]</field>
    </record>

    <record id="view_library_book_request_form_payment" model="ir.ui.view">
        <field name="name">library.book.request.form.payment</field>
        <field name="model">library.book.request</field>
        <field name="inherit_id" ref="view_library_book_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="payment_currency_id" readonly="1"/>
                <field name="payment_transaction_id" readonly="1"/>
                <field name="payment_evidence" filename="payment_evidence_filename"
                       groups="library_manager.group_library_librarian,base.group_system"/>
                <field name="payment_evidence_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_library_ebook_request_form_payment" model="ir.ui.view">
        <field name="name">library.ebook.request.form.payment</field>
        <field name="model">library.ebook.request</field>
        <field name="inherit_id" ref="view_library_ebook_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="payment_currency_id" readonly="1"/>
                <field name="payment_transaction_id" readonly="1"/>
                <field name="payment_evidence" filename="payment_evidence_filename"
                       groups="library_manager.group_library_librarian,base.group_system"/>
                <field name="payment_evidence_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_library_ebook_reservation_form_payment" model="ir.ui.view">
        <field name="name">library.ebook.reservation.form.payment</field>
        <field name="model">library.ebook.reservation</field>
        <field name="inherit_id" ref="view_library_ebook_reservation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="payment_currency_id" readonly="1"/>
                <field name="payment_transaction_id" readonly="1"/>
                <field name="payment_evidence" filename="payment_evidence_filename"
                       groups="library_manager.group_library_librarian,base.group_system"/>
                <field name="payment_evidence_filename" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
