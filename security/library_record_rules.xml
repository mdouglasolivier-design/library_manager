<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_library_ebook_loan_reader" model="ir.rule">
        <field name="name">Readers see their own ebook loans</field>
        <field name="model_id" ref="model_library_ebook_loan"/>
        <field name="domain_force">[('borrower_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_library_ebook_loan_librarian" model="ir.rule">
        <field name="name">Librarians see all ebook loans</field>
        <field name="model_id" ref="model_library_ebook_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('library_manager.group_library_librarian'))]"/>
    </record>
    <record id="rule_library_ebook_loan_system" model="ir.rule">
        <field name="name">System administrators see all ebook loans</field>
        <field name="model_id" ref="model_library_ebook_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

