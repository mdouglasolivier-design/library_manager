    <record id="rule_library_ebook_portal" model="ir.rule">
        <field name="name">Portal members read public and personally borrowed eBooks</field>
        <field name="model_id" ref="model_library_ebook"/>
        <field name="domain_force">['|', '|', '|', '&amp;', ('active', '=', True), ('website_published', '=', True), ('loan_ids.borrower_id', '=', user.partner_id.id), ('reservation_ids.borrower_id', '=', user.partner_id.id), ('request_ids.borrower_id', '=', user.partner_id.id)]</field>
