<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_library_loan_portal_own" model="ir.rule">
        <field name="name">Portal members see their own physical loans</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[('borrower_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_library_loan_librarian_all" model="ir.rule">
        <field name="name">Librarians see all physical loans</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('library_manager.group_library_librarian'))]"/>
    </record>
    <record id="rule_library_loan_admin_all" model="ir.rule">
        <field name="name">Administrators see all physical loans</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_library_book_request_portal_own" model="ir.rule">
        <field name="name">Portal members see their own physical book requests</field>
        <field name="model_id" ref="model_library_book_request"/>
        <field name="domain_force">[('borrower_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_library_book_request_librarian_all" model="ir.rule">
        <field name="name">Librarians manage all physical book requests</field>
        <field name="model_id" ref="model_library_book_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('library_manager.group_library_librarian'))]"/>
    </record>
    <record id="rule_library_book_request_admin_all" model="ir.rule">
        <field name="name">Administrators manage all physical book requests</field>
        <field name="model_id" ref="model_library_book_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
